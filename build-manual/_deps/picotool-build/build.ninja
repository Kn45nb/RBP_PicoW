# =============================================================================
# Object build statements for STATIC_LIBRARY target model


#############################################
# Order-only phony target for model

build cmake_object_order_depends_target_model: phony || cmake_object_order_depends_target_errors model\unreadable_rom_data

build model\CMakeFiles\model.dir\model.cpp.obj: CXX_COMPILER__model_unscanned_Release D$:\GIT\RBP_PicoW\build-manual\_deps\picotool-src\model\model.cpp || cmake_object_order_depends_target_model
  CONFIG = Release
  DEFINES = -DPICO_BUILD=1 -DPICO_NO_HARDWARE=1 -DPICO_ON_DEVICE=0
  FLAGS = -std:c++20
  INCLUDES = -ID:\GIT\RBP_PicoW\build-manual\_deps\picotool-src\model -ID:\GIT\RBP_PicoW\build-manual\_deps\picotool-build\model -ID:\GIT\RBP_PicoW\build-manual\_deps\picotool-src\errors -external:ID:\GIT\RBP_PicoW\pico-sdk-master\src\common\boot_uf2_headers\include -external:ID:\GIT\RBP_PicoW\pico-sdk-master\src\common\boot_picoboot_headers\include -external:ID:\GIT\RBP_PicoW\pico-sdk-master\src\host\pico_platform\include -external:W0
  OBJECT_DIR = model\CMakeFiles\model.dir
  OBJECT_FILE_DIR = model\CMakeFiles\model.dir
  TARGET_COMPILE_PDB = model\CMakeFiles\model.dir\model.pdb
  TARGET_PDB = model\model.pdb
  TARGET_SUPPORT_DIR = model\CMakeFiles\model.dir


